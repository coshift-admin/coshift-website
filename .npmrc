auto-install-peers=true
strict-peer-dependencies=false
# pnpm 11 prompts to approve build scripts on first install; CI/headless runs
# need an explicit allowlist instead. These are the deps that actually need
# native builds. Note: same list lives in package.json#pnpm.onlyBuiltDependencies.
verify-store-integrity=false
ignore-pnpmfile=false
confirm-mod-status-on-install=false
